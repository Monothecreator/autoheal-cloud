# terraform.tfvars.example - Copy to terraform.tfvars and fill in values
# DO NOT commit terraform.tfvars with secrets!

aws_region  = "us-east-1"
environment = "dev"

# Network
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

# EKS
kubernetes_version  = "1.28"
node_instance_types = ["t3.medium"]
desired_node_count  = 3
min_node_count      = 2
max_node_count      = 10
node_disk_size      = 30

# IAM
app_namespace        = "default"
app_service_account  = "autoheal-cloud"

# Monitoring
log_retention_days = 30
alert_email        = "your-email@example.com"

# Secrets (use environment variables or AWS Secrets Manager in production!)
# DO NOT hardcode these in terraform.tfvars
db_host     = "your-db-host.rds.amazonaws.com"
db_port     = 5432
db_username = "postgres"
db_password = "your-secure-password"
db_name     = "autoheal_cloud"
api_key     = "your-api-key"
